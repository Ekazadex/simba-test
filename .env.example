# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
# Never prefix with VITE_. Set in AI Studio Secrets or backend host env vars.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Web Config (set in Vercel / CI Environment Variables so firebase-applet-config.json stays out of Git)
VITE_FIREBASE_PROJECT_ID="MY_FIREBASE_PROJECT_ID"
VITE_FIREBASE_APP_ID="MY_FIREBASE_APP_ID"
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="MY_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_DATABASE_ID="(default)"
VITE_FIREBASE_STORAGE_BUCKET="MY_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="MY_FIREBASE_MESSAGING_SENDER_ID"
